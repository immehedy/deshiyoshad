# Contentful (optional - when empty, the app uses built-in static content)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Contentful locale codes configured in your Contentful space
CONTENTFUL_LOCALE_EN=en-US
CONTENTFUL_LOCALE_BN=bn-BD

# Secret for the /api/revalidate webhook (Contentful -> this app)
REVALIDATE_SECRET=secret

# Public site URL used for SEO tags, sitemap and the Facebook catalog feed
NEXT_PUBLIC_SITE_URL=https://deshiyoshad.com
